<template name="immersive-chrome">
  <view class="imm-chrome" catchtap="handleChromeNoop">
    <view wx:if="{{showTop}}" class="imm-top" style="{{topStyle}}" catchtap="handleChromeNoop">
      <view class="imm-top__leading">
        <view
          class="imm-circle"
          data-action="exit"
          catchtap="handleChromeAction"
          hover-class="is-pressed"
          hover-start-time="0"
          hover-stay-time="90"
          aria-role="button"
          aria-label="关闭"
        >
          <view class="imm-close">
            <view class="imm-close__line imm-close__line--a"></view>
            <view class="imm-close__line imm-close__line--b"></view>
          </view>
        </view>

        <view
          class="imm-circle"
          data-action="settings"
          catchtap="handleChromeAction"
          hover-class="is-pressed"
          hover-start-time="0"
          hover-stay-time="90"
          aria-role="button"
          aria-label="设置"
        >
          <view class="imm-sliders">
            <view class="imm-slider imm-slider--one"></view>
            <view class="imm-slider imm-slider--two"></view>
            <view class="imm-slider imm-slider--three"></view>
          </view>
        </view>
      </view>

      <view class="imm-top__trailing" style="{{rightStyle}}">
        <view
          class="imm-focus"
          data-action="focus"
          catchtap="handleChromeAction"
          hover-class="is-pressed"
          hover-start-time="0"
          hover-stay-time="90"
          aria-role="button"
          aria-label="关灯引导"
        >
          <view class="imm-focus__icon">
            <view class="imm-focus__orbit"></view>
            <view class="imm-focus__cut"></view>
          </view>
          <text class="imm-focus__label">关灯</text>
        </view>
      </view>
    </view>

    <view wx:if="{{showBottom}}" class="imm-bottom" catchtap="handleChromeNoop">
      <view
        class="imm-nav-item"
        data-action="body"
        catchtap="handleChromeAction"
        hover-class="is-pressed"
        hover-start-time="0"
        hover-stay-time="90"
        aria-role="button"
        aria-label="身体"
      >
        <view class="imm-body-icon" aria-hidden="true">
          <view class="imm-body-icon__head"></view>
          <view class="imm-body-icon__shoulders"></view>
        </view>
        <text class="imm-nav-label">身体</text>
      </view>

      <view
        class="imm-nav-item imm-nav-item--active"
        data-action="world"
        catchtap="handleChromeAction"
        hover-class="is-pressed"
        hover-start-time="0"
        hover-stay-time="90"
        aria-role="button"
        aria-label="呼吸世界"
      >
        <view class="imm-world-icon" aria-hidden="true">
          <view class="imm-world-icon__core"></view>
          <view class="imm-world-icon__ray imm-world-icon__ray--top"></view>
          <view class="imm-world-icon__ray imm-world-icon__ray--right"></view>
          <view class="imm-world-icon__ray imm-world-icon__ray--bottom"></view>
          <view class="imm-world-icon__ray imm-world-icon__ray--left"></view>
        </view>
        <text class="imm-nav-label">呼吸世界</text>
        <view class="imm-nav-active" aria-hidden="true"></view>
      </view>

      <view
        class="imm-nav-item"
        data-action="records"
        catchtap="handleChromeAction"
        hover-class="is-pressed"
        hover-start-time="0"
        hover-stay-time="90"
        aria-role="button"
        aria-label="记录"
      >
        <view class="imm-record-icon" aria-hidden="true">
          <view class="imm-record-icon__sheet"></view>
          <view class="imm-record-icon__line imm-record-icon__line--one"></view>
          <view class="imm-record-icon__line imm-record-icon__line--two"></view>
        </view>
        <text class="imm-nav-label">记录</text>
      </view>
    </view>
  </view>
</template>
