<view class="imm-chrome">
  <view wx:if="{{showTop}}" class="imm-top" style="{{topStyle}}" catchtap="noop">
    <view class="imm-top__leading">
      <view
        class="imm-circle"
        catchtap="handleExit"
        hover-class="is-pressed"
        hover-start-time="0"
        hover-stay-time="90"
        aria-role="button"
        aria-label="关闭"
      >
        <image class="imm-icon" src="/assets/chrome/close.png" mode="aspectFit"></image>
      </view>

      <view
        class="imm-circle"
        catchtap="handleSettings"
        hover-class="is-pressed"
        hover-start-time="0"
        hover-stay-time="90"
        aria-role="button"
        aria-label="设置"
      >
        <image class="imm-icon" src="/assets/chrome/settings.png" mode="aspectFit"></image>
      </view>
    </view>

    <view class="imm-top__trailing" style="{{rightStyle}}">
      <view
        class="imm-focus"
        catchtap="handleFocus"
        hover-class="is-pressed"
        hover-start-time="0"
        hover-stay-time="90"
        aria-role="button"
        aria-label="关灯引导"
      >
        <image class="imm-icon imm-icon--focus" src="/assets/chrome/focus.png" mode="aspectFit"></image>
        <text class="imm-focus__label">关灯</text>
      </view>
    </view>
  </view>

  <view wx:if="{{showBottom}}" class="imm-bottom" catchtap="noop">
    <view
      class="imm-nav-item"
      catchtap="handleBody"
      hover-class="is-pressed"
      hover-start-time="0"
      hover-stay-time="90"
      aria-role="button"
      aria-label="身体"
    >
      <image class="imm-nav-icon" src="/assets/chrome/body.png" mode="aspectFit" aria-hidden="true"></image>
      <text class="imm-nav-label">身体</text>
    </view>

    <view
      class="imm-nav-item imm-nav-item--active"
      catchtap="handleWorld"
      hover-class="is-pressed"
      hover-start-time="0"
      hover-stay-time="90"
      aria-role="button"
      aria-label="呼吸世界"
    >
      <image class="imm-nav-icon" src="/assets/chrome/world.png" mode="aspectFit" aria-hidden="true"></image>
      <text class="imm-nav-label">呼吸世界</text>
      <view class="imm-nav-active" aria-hidden="true"></view>
    </view>

    <view
      class="imm-nav-item"
      catchtap="handleRecords"
      hover-class="is-pressed"
      hover-start-time="0"
      hover-stay-time="90"
      aria-role="button"
      aria-label="记录"
    >
      <image class="imm-nav-icon" src="/assets/chrome/record.png" mode="aspectFit" aria-hidden="true"></image>
      <text class="imm-nav-label">记录</text>
    </view>
  </view>
</view>
