.imm-chrome {
  position: fixed;
  z-index: 100;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  pointer-events: none;
}

.imm-top {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  pointer-events: auto;
}

.imm-top__leading,
.imm-top__trailing {
  position: absolute;
  bottom: 0;
  display: flex;
  align-items: center;
}

.imm-top__leading {
  left: 40rpx;
  gap: 46rpx;
}

.imm-top__trailing {
  right: 0;
}

.imm-circle,
.imm-focus {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border: 1rpx solid rgba(215, 231, 246, 0.2);
  color: rgba(242, 247, 252, 0.96);
  background: rgba(18, 35, 58, 0.84);
  box-shadow:
    0 12rpx 34rpx rgba(1, 7, 18, 0.32),
    inset 0 0 28rpx rgba(122, 170, 218, 0.06);
  transform: translate3d(0, 0, 0) scale(1);
  transition: transform 140ms ease, opacity 140ms ease;
  will-change: transform, opacity;
}

.imm-circle {
  width: 88rpx;
  min-width: 88rpx;
  border-radius: 50%;
}

.imm-focus {
  width: 164rpx;
  min-width: 164rpx;
  padding: 0 22rpx;
  gap: 12rpx;
  border-radius: 44rpx;
}

.imm-icon {
  display: block;
  width: 42rpx;
  height: 42rpx;
  flex: 0 0 42rpx;
  opacity: 0.98;
}

.imm-icon--focus {
  width: 36rpx;
  height: 36rpx;
  flex-basis: 36rpx;
}

.is-pressed {
  opacity: 0.72;
  transform: translate3d(0, 0, 0) scale(0.95);
}

.imm-close {
  position: relative;
  width: 32rpx;
  height: 32rpx;
}

.imm-close__line {
  position: absolute;
  top: 15rpx;
  left: 1rpx;
  width: 30rpx;
  height: 2rpx;
  border-radius: 2rpx;
  background: currentColor;
}

.imm-close__line--a {
  transform: rotate(45deg);
}

.imm-close__line--b {
  transform: rotate(-45deg);
}

.imm-sliders {
  position: relative;
  width: 40rpx;
  height: 34rpx;
}

.imm-slider {
  position: absolute;
  left: 2rpx;
  width: 34rpx;
  height: 2rpx;
  border-radius: 2rpx;
  background: currentColor;
}

.imm-slider::after {
  content: '';
  position: absolute;
  top: -5rpx;
  width: 10rpx;
  height: 10rpx;
  border: 2rpx solid currentColor;
  border-radius: 50%;
  background: #122338;
}

.imm-slider--one {
  top: 4rpx;
}

.imm-slider--two {
  top: 15rpx;
}

.imm-slider--three {
  top: 26rpx;
}

.imm-slider--one::after,
.imm-slider--three::after {
  left: 5rpx;
}

.imm-slider--two::after {
  right: 5rpx;
}

.imm-focus__icon {
  position: relative;
  width: 30rpx;
  height: 30rpx;
}

.imm-focus__orbit {
  box-sizing: border-box;
  position: absolute;
  top: 1rpx;
  left: 1rpx;
  width: 28rpx;
  height: 28rpx;
  border: 2rpx solid rgba(239, 245, 252, 0.9);
  border-radius: 50%;
}

.imm-focus__cut {
  position: absolute;
  top: 13rpx;
  left: 0;
  width: 32rpx;
  height: 2rpx;
  transform: rotate(-38deg);
  background: rgba(239, 245, 252, 0.9);
}

.imm-focus__label {
  font-size: 25rpx;
  line-height: 34rpx;
  font-weight: 300;
  color: rgba(239, 245, 252, 0.9);
}

.imm-bottom {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: stretch;
  min-height: calc(env(safe-area-inset-bottom) + 164rpx);
  padding: 4rpx 40rpx calc(env(safe-area-inset-bottom) + 10rpx);
  background: linear-gradient(180deg, rgba(2, 7, 15, 0), rgba(2, 6, 14, 0.72) 50%, rgba(2, 5, 12, 0.94));
  pointer-events: auto;
}

.imm-nav-item {
  position: relative;
  display: flex;
  flex: 1 1 0;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  min-width: 0;
  min-height: 140rpx;
  padding: 0 4rpx 18rpx;
  color: rgba(226, 235, 245, 0.78);
}

.imm-nav-item--active {
  color: rgba(252, 253, 255, 1);
}

.imm-nav-icon {
  display: block;
  width: 48rpx;
  height: 48rpx;
  flex: 0 0 48rpx;
  opacity: 0.82;
}

.imm-nav-item--active .imm-nav-icon {
  opacity: 1;
}

.imm-nav-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 30rpx;
  font-weight: 300;
  white-space: nowrap;
}

.imm-nav-active {
  position: absolute;
  bottom: 0;
  left: 50%;
  width: 36rpx;
  height: 2rpx;
  border-radius: 2rpx;
  transform: translateX(-50%);
  background: rgba(246, 250, 255, 0.94);
  box-shadow: 0 0 12rpx rgba(218, 235, 255, 0.42);
}

.imm-body-icon,
.imm-world-icon,
.imm-record-icon {
  position: relative;
  width: 48rpx;
  height: 48rpx;
  flex: 0 0 48rpx;
  color: currentColor;
}

.imm-body-icon__head {
  box-sizing: border-box;
  position: absolute;
  top: 2rpx;
  left: 18rpx;
  width: 12rpx;
  height: 12rpx;
  border: 2rpx solid currentColor;
  border-radius: 50%;
}

.imm-body-icon__shoulders {
  box-sizing: border-box;
  position: absolute;
  bottom: 4rpx;
  left: 7rpx;
  width: 34rpx;
  height: 19rpx;
  border: 2rpx solid currentColor;
  border-bottom: 0;
  border-radius: 18rpx 18rpx 0 0;
}

.imm-world-icon__core {
  position: absolute;
  top: 21rpx;
  left: 21rpx;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: currentColor;
}

.imm-world-icon__ray {
  position: absolute;
  top: 4rpx;
  left: 23rpx;
  width: 2rpx;
  height: 15rpx;
  border-radius: 2rpx;
  background: currentColor;
  transform-origin: 1rpx 20rpx;
}

.imm-world-icon__ray--right {
  transform: rotate(90deg);
}

.imm-world-icon__ray--bottom {
  transform: rotate(180deg);
}

.imm-world-icon__ray--left {
  transform: rotate(270deg);
}

.imm-record-icon__sheet {
  box-sizing: border-box;
  position: absolute;
  top: 4rpx;
  left: 11rpx;
  width: 28rpx;
  height: 38rpx;
  border: 2rpx solid currentColor;
  border-radius: 3rpx;
}

.imm-record-icon__line {
  position: absolute;
  left: 17rpx;
  width: 16rpx;
  height: 2rpx;
  border-radius: 2rpx;
  background: currentColor;
}

.imm-record-icon__line--one {
  top: 18rpx;
}

.imm-record-icon__line--two {
  top: 27rpx;
}
