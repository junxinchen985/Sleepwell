<!--
  萤火虫页
  ---------------------------------------------------------------------------
  版式（从上到下）：
    ① 舞台：Canvas 2D 只画光效，透明底
    ② 沉浸控件：共享顶部与底部入口
    ③ 设置面板：底部弹出

  交互：轻触屏幕任意位置或按钮即可开始 / 结束呼吸循环。
  注意：canvas 是微信原生组件，层级高于普通 DOM，
  所以它只能待在 ③ 的舞台盒子里，且保持透明底。
-->
<view class="fb-page" bindtap="handleTap">

  <!-- 星空背景：必须用 <image> 组件。
       微信的 WXSS 不能用 background-image 引用本地图片（只能走网络图或 base64），
       写成 CSS 会被静默忽略，结果只剩一层兜底底色。 -->
  <image
    class="fb-sky"
    src="/assets/breath-firefly/sky-bg.png"
    mode="aspectFill"
    aria-hidden="true"
  ></image>

  <!-- ======================= 舞台 ======================= -->
  <!-- canvas 是原生组件，用 catchtap 自己处理轻触并阻止冒泡 -->
  <view class="fb-stage">
    <canvas
      type="2d"
      id="firefly"
      class="fb-canvas"
      disable-scroll="true"
      catchtap="handleTap"
      aria-label="轻触切换呼吸状态"
    ></canvas>
  </view>

  <immersive-chrome></immersive-chrome>
  <view class="breathing-control-anchor">
    <breathing-action-button active="{{isBreathing}}" bind:toggle="handleTap"></breathing-action-button>
  </view>

  <!-- ======================= 设置面板 ======================= -->
  <view class="sheet-mask {{showSettings ? 'is-open' : ''}}" catchtap="closeSettings">
    <view class="bottom-sheet fb-sheet" catchtap="noop">
      <view class="sheet-handle"></view>
      <button class="sheet-close" catchtap="closeSettings" aria-label="关闭呼吸设置">
        <view class="close-icon"></view>
      </button>
      <text class="sheet-title">呼吸设置</text>

      <!-- 我的呼吸世界 -->
      <picker mode="selector" range="{{worlds}}" range-key="name" bindchange="onWorldChange">
        <view class="setting-row">
          <text class="setting-label">我的呼吸世界</text>
          <text class="setting-value">{{currentWorld.name}} ›</text>
        </view>
      </picker>

      <!-- 呼吸节奏 -->
      <picker mode="selector" range="{{rhythms}}" range-key="name" bindchange="onRhythmChange">
        <view class="setting-row">
          <text class="setting-label">呼吸节奏</text>
          <text class="setting-value">{{currentRhythm.name}} ›</text>
        </view>
      </picker>

      <!-- 呼吸次数 -->
      <picker mode="selector" range="{{cycleOptions}}" range-key="name" bindchange="onCycleChange">
        <view class="setting-row">
          <text class="setting-label">呼吸次数</text>
          <text class="setting-value">{{currentCycle.name}} ›</text>
        </view>
      </picker>

      <!-- 声音 -->
      <picker mode="selector" range="{{soundOptions}}" range-key="name" bindchange="onSoundChange">
        <view class="setting-row">
          <text class="setting-label">声音</text>
          <text class="setting-value">{{currentSound.name}} ›</text>
        </view>
      </picker>

      <!-- 触觉反馈 -->
      <view class="setting-row">
        <text class="setting-label">触觉反馈</text>
        <switch checked="{{settings.hapticEnabled}}" color="#FFB347" data-key="hapticEnabled" bindchange="onToggleChange"></switch>
      </view>

      <!-- 结束提示音 -->
      <view class="setting-row">
        <text class="setting-label">结束提示音</text>
        <switch checked="{{settings.endSoundEnabled}}" color="#FFB347" data-key="endSoundEnabled" bindchange="onToggleChange"></switch>
      </view>

      <button class="fb-sound-link" data-url="/pages/sound/index" bindtap="goPage">
        <text>打开白噪音播放器</text>
        <text class="fb-sound-link__arrow">›</text>
      </button>
    </view>
  </view>

</view>
