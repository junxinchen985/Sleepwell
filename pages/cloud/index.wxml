<!--
  Figma 节点映射：
  Main/Container              -> .cloud-page
  Backdrop/Cloud_1/2/3        -> .cloud--one / .cloud--two / .cloud--three
  UI/NavBar                   -> immersive-chrome
  UI/Bottom/PressRing         -> immersive-chrome
  Settings/BottomSheet/List   -> wx:for="{{settingRows}}"
-->
<view class="cloud-page cloud-page--{{phase}} {{isRunning ? 'is-running' : ''}}" style="{{themeStyle}}">
  <view class="cloud-backdrop" aria-hidden="true">
    <image class="cloud cloud--one" style="{{cloudOneStyle}}" src="/assets/cloud/cloud_1.jpg" mode="aspectFill" draggable="false"></image>
    <image class="cloud cloud--two" style="{{cloudTwoStyle}}" src="/assets/cloud/cloud_2.jpg" mode="aspectFill" draggable="false"></image>
    <image class="cloud cloud--three" style="{{cloudThreeStyle}}" src="/assets/cloud/cloud_3.jpg" mode="aspectFill" draggable="false"></image>
    <view class="cloud-shade cloud-shade--top"></view>
    <view class="cloud-shade cloud-shade--bottom"></view>
  </view>

  <immersive-chrome></immersive-chrome>
  <view wx:if="{{!settingsVisible && !completionVisible}}" class="breathing-control-anchor">
    <breathing-action-button active="{{isRunning}}" bind:toggle="toggleBreathing"></breathing-action-button>
  </view>

  <view class="cloud-sheet-root {{settingsVisible ? 'is-open' : ''}}">
    <view class="cloud-sheet-mask" bindtap="closeSettings" aria-hidden="true"></view>

    <view class="cloud-sheet-panel" catchtap="noop" aria-role="dialog" aria-modal="true">
      <view class="cloud-sheet-handle" aria-hidden="true"></view>

      <view class="cloud-sheet-head">
        <text class="cloud-sheet-title">呼吸设置</text>
        <view
          class="cloud-sheet-close"
          bindtap="closeSettings"
          hover-class="cloud-sheet-close--pressed"
          hover-start-time="0"
          hover-stay-time="120"
          aria-role="button"
          aria-label="关闭"
        >
          <view class="cloud-sheet-close__line cloud-sheet-close__line--a"></view>
          <view class="cloud-sheet-close__line cloud-sheet-close__line--b"></view>
        </view>
      </view>

      <view class="cloud-setting-list">
        <view
          wx:for="{{settingRows}}"
          wx:key="id"
          class="cloud-setting-row"
          data-id="{{item.id}}"
          catchtap="handleSettingRow"
        >
          <text class="cloud-setting-row__label">{{item.label}}</text>

          <view
            wx:if="{{item.type === 'switch'}}"
            class="cloud-toggle {{item.checked ? 'is-on' : ''}}"
            data-id="{{item.id}}"
            catchtap="handleToggle"
            aria-role="switch"
            aria-checked="{{item.checked}}"
          >
            <view class="cloud-toggle__thumb"></view>
          </view>

          <view wx:else class="cloud-setting-row__value">
            <text class="cloud-setting-row__text">{{item.value}}</text>
            <text class="cloud-setting-row__arrow">›</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
