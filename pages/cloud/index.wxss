page {
  background: #06192B;
}

.breathing-control-anchor {
  position: absolute;
  z-index: 105;
  bottom: calc(env(safe-area-inset-bottom) + 320rpx);
  left: 50%;
  transform: translateX(-50%);
}

.cloud-page {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: #06192B;
  color: #F7FBFF;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.cloud-topbar {
  box-sizing: border-box;
  position: absolute;
  z-index: 60;
  top: 0;
  right: 0;
  left: 0;
  pointer-events: none;
}

.cloud-topbar__icon {
  position: absolute;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  pointer-events: auto;
  transition: transform 160ms ease, opacity 160ms ease;
  will-change: transform, opacity;
}

.cloud-topbar__icon--left {
  left: 28rpx;
}

.cloud-topbar__icon--pressed {
  opacity: 0.62;
  transform: translate3d(0, 0, 0) scale(0.92);
}

.cloud-topbar__glyph {
  display: block;
  width: 46rpx;
  height: 46rpx;
  filter: drop-shadow(0 0 10rpx rgba(240, 248, 255, 0.32));
}

.cloud-topbar__glyph--back {
  width: 38rpx;
  height: 38rpx;
}

.cloud-topbar__glyph--settings {
  width: 43rpx;
  height: 43rpx;
}

.cloud-topbar__center {
  position: absolute;
  right: 150rpx;
  left: 150rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  pointer-events: none;
}

.cloud-topbar__title,
.cloud-topbar__subtitle {
  display: block;
  white-space: nowrap;
}

.cloud-topbar__title {
  color: #F7FBFF;
  font-size: 42rpx;
  font-weight: 500;
  line-height: 52rpx;
  text-shadow:
    0 0 10rpx rgba(242, 249, 255, 0.34),
    0 0 30rpx rgba(128, 196, 226, 0.2);
}

.cloud-topbar__subtitle {
  margin-top: 8rpx;
  color: rgba(232, 242, 248, 0.76);
  font-size: 22rpx;
  font-weight: 300;
  line-height: 28rpx;
  letter-spacing: 3rpx;
  text-shadow: 0 0 12rpx rgba(207, 230, 241, 0.18);
  transition: color 220ms ease, opacity 220ms ease;
}

.cloud-topbar__subtitle--inhale,
.cloud-topbar__subtitle--hold,
.cloud-topbar__subtitle--exhale {
  color: rgba(249, 253, 255, 0.98);
}

.cloud-backdrop,
.cloud-shade {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
}

.cloud-backdrop {
  z-index: 1;
  overflow: hidden;
  background:
    linear-gradient(180deg, #041B31 0%, #0A3455 48%, #0B3854 100%);
}

.cloud {
  position: absolute;
  top: -2%;
  left: 0;
  display: block;
  width: 100%;
  height: 104%;
  opacity: 0;
  transform: translate3d(0, 0, 0) scale(1);
  transform-origin: 50% 48%;
  will-change: transform, opacity;
}

.cloud--one {
  opacity: 1;
}

.cloud-shade {
  z-index: 6;
  pointer-events: none;
}

.cloud-shade--top {
  background:
    radial-gradient(circle at 50% 4%, rgba(5, 21, 40, 0.68) 0%, rgba(5, 21, 40, 0) 44%),
    linear-gradient(180deg, rgba(1, 12, 24, 0.64) 0%, rgba(1, 12, 24, 0) 28%);
}

.cloud-shade--bottom {
  background:
    linear-gradient(180deg, rgba(2, 16, 30, 0) 55%, rgba(2, 14, 27, 0.4) 76%, rgba(1, 11, 22, 0.72) 100%),
    radial-gradient(circle at 50% 82%, rgba(64, 146, 190, 0.12) 0%, rgba(3, 18, 33, 0) 42%);
}

.cloud-dock {
  position: absolute;
  z-index: 20;
  right: 0;
  bottom: calc(env(safe-area-inset-bottom) + 76rpx);
  left: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  pointer-events: none;
}

.cloud-press {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 208rpx;
  height: 208rpx;
  border: 1rpx solid rgba(235, 248, 255, 0.42);
  border-radius: 50%;
  background: rgba(235, 248, 255, 0.045);
  box-shadow:
    0 0 28rpx rgba(229, 247, 255, 0.1),
    0 0 84rpx rgba(111, 192, 228, 0.16),
    inset 0 0 0 14rpx rgba(226, 246, 255, 0.025);
  pointer-events: auto;
  touch-action: none;
  transform: translate3d(0, 0, 0) scale(1);
  transition: transform 220ms ease, opacity 220ms ease, border-color 320ms ease;
  will-change: transform, opacity;
}

.cloud-press.is-running {
  border-color: rgba(225, 248, 255, 0.72);
  box-shadow:
    0 0 36rpx rgba(238, 252, 255, 0.28),
    0 0 108rpx rgba(110, 205, 240, 0.3),
    inset 0 0 0 14rpx rgba(226, 246, 255, 0.04);
}

.cloud-press--pressed {
  opacity: 0.86;
  transform: translate3d(0, 0, 0) scale(0.95);
}

.cloud-press__halo,
.cloud-press__ring,
.cloud-press__core {
  position: absolute;
  border-radius: 50%;
}

.cloud-press__halo {
  top: 50%;
  left: 50%;
  width: 228rpx;
  height: 228rpx;
  margin: -114rpx 0 0 -114rpx;
  background: radial-gradient(
    circle,
    rgba(232, 250, 255, 0.2) 0%,
    rgba(116, 205, 239, 0.1) 36%,
    rgba(70, 155, 199, 0) 70%
  );
  opacity: 0.28;
  transform: translate3d(0, 0, 0) scale(0.92);
  transition: opacity 260ms ease;
  will-change: transform, opacity;
}

.cloud-press__ring {
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  border: 1rpx solid rgba(235, 248, 255, 0.38);
  opacity: 0.78;
  transform: translate3d(0, 0, 0) scale(1);
  will-change: transform, opacity;
}

.cloud-press__core {
  top: 50%;
  left: 50%;
  width: 132rpx;
  height: 132rpx;
  margin: -66rpx 0 0 -66rpx;
  border: 1rpx solid rgba(240, 251, 255, 0.34);
  background: radial-gradient(
    circle at 42% 32%,
    rgba(255, 255, 255, 0.82) 0%,
    rgba(216, 242, 251, 0.48) 34%,
    rgba(151, 213, 236, 0.24) 70%,
    rgba(93, 167, 203, 0.1) 100%
  );
  box-shadow:
    0 0 20rpx rgba(242, 252, 255, 0.24),
    0 0 72rpx rgba(122, 209, 239, 0.2),
    inset 0 2rpx 8rpx rgba(255, 255, 255, 0.28);
  opacity: 0.78;
  transform: translate3d(0, 0, 0) scale(1);
  will-change: transform, opacity;
}

.cloud-dock__label {
  display: block;
  margin-top: 34rpx;
  color: rgba(242, 249, 253, 0.88);
  font-size: 25rpx;
  font-weight: 300;
  line-height: 34rpx;
  letter-spacing: 4rpx;
  text-align: center;
  text-shadow:
    0 0 10rpx rgba(238, 250, 255, 0.25),
    0 0 28rpx rgba(109, 190, 225, 0.22);
  transition: color 260ms ease, letter-spacing 260ms ease;
  pointer-events: none;
}

.cloud-press--inhale .cloud-press__halo {
  animation: press-halo-inhale 4000ms ease-out forwards;
  animation: press-halo-inhale var(--cloud-inhale-duration, 4000ms) ease-out forwards;
}

.cloud-press--inhale .cloud-press__ring {
  animation: press-ring-inhale 4000ms ease-out forwards;
  animation: press-ring-inhale var(--cloud-inhale-duration, 4000ms) ease-out forwards;
}

.cloud-press--inhale .cloud-press__core {
  animation: press-core-inhale 4000ms ease-out forwards;
  animation: press-core-inhale var(--cloud-inhale-duration, 4000ms) ease-out forwards;
}

.cloud-dock__label--inhale {
  color: rgba(249, 253, 255, 0.98);
  letter-spacing: 7rpx;
}

.cloud-press--hold .cloud-press__halo {
  animation: press-halo-hold 2600ms ease-in-out infinite alternate;
}

.cloud-press--hold .cloud-press__ring {
  animation: press-ring-hold 2600ms ease-in-out infinite alternate;
}

.cloud-press--hold .cloud-press__core {
  animation: press-core-hold 2600ms ease-in-out infinite alternate;
}

.cloud-dock__label--hold {
  color: rgba(241, 249, 253, 0.9);
}

.cloud-press--exhale .cloud-press__halo {
  animation: press-halo-exhale 8000ms ease-in forwards;
  animation: press-halo-exhale var(--cloud-exhale-duration, 8000ms) ease-in forwards;
}

.cloud-press--exhale .cloud-press__ring {
  animation: press-ring-exhale 8000ms ease-in forwards;
  animation: press-ring-exhale var(--cloud-exhale-duration, 8000ms) ease-in forwards;
}

.cloud-press--exhale .cloud-press__core {
  animation: press-core-exhale 8000ms ease-in forwards;
  animation: press-core-exhale var(--cloud-exhale-duration, 8000ms) ease-in forwards;
}

.cloud-dock__label--exhale {
  color: rgba(235, 246, 251, 0.76);
}

.cloud-sheet-root {
  position: fixed;
  z-index: 80;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  visibility: hidden;
  pointer-events: none;
}

.cloud-sheet-root.is-open {
  visibility: visible;
  pointer-events: auto;
}

.cloud-sheet-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(1, 11, 23, 0.46);
  opacity: 0;
  -webkit-backdrop-filter: blur(0);
  backdrop-filter: blur(0);
  transition: opacity 320ms ease, backdrop-filter 320ms ease;
}

.cloud-sheet-root.is-open .cloud-sheet-mask {
  opacity: 1;
  -webkit-backdrop-filter: blur(16px) saturate(125%);
  backdrop-filter: blur(16px) saturate(125%);
}

.cloud-sheet-panel {
  box-sizing: border-box;
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  min-height: 480rpx;
  max-height: 86vh;
  padding: 18rpx 34rpx calc(env(safe-area-inset-bottom) + 34rpx);
  overflow: hidden;
  border-top: 1rpx solid rgba(232, 246, 255, 0.18);
  border-radius: 30rpx 30rpx 0 0;
  background: rgba(8, 31, 53, 0.9);
  box-shadow:
    0 -24rpx 80rpx rgba(0, 7, 17, 0.34),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.08);
  -webkit-backdrop-filter: blur(34px) saturate(145%);
  backdrop-filter: blur(34px) saturate(145%);
  transform: translate3d(0, 104%, 0);
  transition: transform 340ms cubic-bezier(0.2, 0.82, 0.2, 1);
  will-change: transform;
}

.cloud-sheet-root.is-open .cloud-sheet-panel {
  transform: translate3d(0, 0, 0);
}

.cloud-sheet-handle {
  width: 72rpx;
  height: 6rpx;
  margin: 0 auto 30rpx;
  border-radius: 6rpx;
  background: rgba(236, 247, 255, 0.22);
}

.cloud-sheet-head {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 58rpx;
  margin-bottom: 12rpx;
}

.cloud-sheet-title {
  color: #F6FBFF;
  font-size: 34rpx;
  font-weight: 500;
  line-height: 46rpx;
}

.cloud-sheet-close {
  position: absolute;
  top: 50%;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  margin-top: -29rpx;
  border-radius: 50%;
  background: rgba(238, 248, 255, 0.065);
  transition: transform 160ms ease, opacity 160ms ease;
}

.cloud-sheet-close--pressed {
  opacity: 0.62;
  transform: scale(0.92);
}

.cloud-sheet-close__line {
  position: absolute;
  top: 28rpx;
  left: 19rpx;
  width: 20rpx;
  height: 2rpx;
  border-radius: 2rpx;
  background: rgba(239, 248, 255, 0.78);
}

.cloud-sheet-close__line--a {
  transform: rotate(45deg);
}

.cloud-sheet-close__line--b {
  transform: rotate(-45deg);
}

.cloud-setting-list {
  max-height: calc(86vh - 170rpx);
  overflow-y: auto;
  border-top: 1rpx solid rgba(235, 247, 255, 0.08);
}

.cloud-setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 108rpx;
  border-bottom: 1rpx solid rgba(235, 247, 255, 0.085);
}

.cloud-setting-row__label {
  color: rgba(246, 251, 255, 0.94);
  font-size: 28rpx;
  font-weight: 400;
  line-height: 40rpx;
}

.cloud-setting-row__value {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  min-width: 0;
  color: rgba(226, 241, 248, 0.68);
}

.cloud-setting-row__text {
  overflow: hidden;
  max-width: 280rpx;
  font-size: 26rpx;
  line-height: 38rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cloud-setting-row__arrow {
  margin-left: 12rpx;
  color: rgba(226, 242, 249, 0.58);
  font-size: 38rpx;
  font-weight: 200;
  line-height: 38rpx;
}

.cloud-toggle {
  position: relative;
  box-sizing: border-box;
  width: 94rpx;
  height: 52rpx;
  border: 1rpx solid rgba(229, 245, 252, 0.18);
  border-radius: 28rpx;
  background: rgba(224, 242, 250, 0.14);
  transition: background-color 240ms ease, border-color 240ms ease;
}

.cloud-toggle.is-on {
  border-color: rgba(196, 238, 252, 0.62);
  background: rgba(149, 218, 241, 0.72);
}

.cloud-toggle__thumb {
  position: absolute;
  top: 5rpx;
  left: 5rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 3rpx 12rpx rgba(1, 13, 25, 0.22);
  transform: translate3d(0, 0, 0);
  transition: transform 240ms cubic-bezier(0.2, 0.8, 0.2, 1);
  will-change: transform;
}

.cloud-toggle.is-on .cloud-toggle__thumb {
  transform: translate3d(42rpx, 0, 0);
}

@keyframes press-ring-inhale {
  from {
    opacity: 0.58;
    transform: translate3d(0, 0, 0) scale(0.94);
  }
  to {
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1.09);
  }
}

@keyframes press-ring-hold {
  from {
    opacity: 0.78;
    transform: translate3d(0, 0, 0) scale(1.04);
  }
  to {
    opacity: 0.94;
    transform: translate3d(0, 0, 0) scale(1.075);
  }
}

@keyframes press-ring-exhale {
  from {
    opacity: 0.94;
    transform: translate3d(0, 0, 0) scale(1.07);
  }
  to {
    opacity: 0.42;
    transform: translate3d(0, 0, 0) scale(0.9);
  }
}

@keyframes press-core-inhale {
  from {
    opacity: 0.68;
    transform: translate3d(0, 0, 0) scale(0.88);
  }
  to {
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1.13);
  }
}

@keyframes press-core-hold {
  from {
    opacity: 0.92;
    transform: translate3d(0, 0, 0) scale(1.08);
  }
  to {
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1.11);
  }
}

@keyframes press-core-exhale {
  from {
    opacity: 0.95;
    transform: translate3d(0, 0, 0) scale(1.1);
  }
  to {
    opacity: 0.5;
    transform: translate3d(0, 0, 0) scale(0.86);
  }
}

@keyframes press-halo-inhale {
  from {
    opacity: 0.2;
    transform: translate3d(0, 0, 0) scale(0.88);
  }
  to {
    opacity: 0.72;
    transform: translate3d(0, 0, 0) scale(1.18);
  }
}

@keyframes press-halo-hold {
  from {
    opacity: 0.56;
    transform: translate3d(0, 0, 0) scale(1.08);
  }
  to {
    opacity: 0.76;
    transform: translate3d(0, 0, 0) scale(1.16);
  }
}

@keyframes press-halo-exhale {
  from {
    opacity: 0.68;
    transform: translate3d(0, 0, 0) scale(1.12);
  }
  to {
    opacity: 0.16;
    transform: translate3d(0, 0, 0) scale(0.84);
  }
}
